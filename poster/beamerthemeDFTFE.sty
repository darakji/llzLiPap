% DFTFE theme. 
% Created by modifying beamerthemeLankton 
 
\ProvidesPackage{beamerthemeDFTFE}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<presentation>
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\definecolor{butter}{rgb}{0.98824, 0.91373, 0.30980}		% #fce94f
% \definecolor{lightblue}{rgb}{0.2, 0.8, 1.5}
\definecolor{lightblue}{RGB}{189, 199, 218}
\definecolor{lightgray}{RGB}{226,234,237}
\setbeamercolor{headline}{bg=white}
\setbeamercolor{footline}{bg=white}
\setbeamerfont{footline}{size=\large}
\setbeamercolor{separation line}{bg=black}
\setbeamercolor{title in headline}{fg=black}
\setbeamercolor{author in headline}{fg=black}
\setbeamercolor{institute in headline}{fg=lightgray}

\setbeamercolor{framesubtitle}{fg=blue, bg=gray}
\setbeamercolor{author in head/foot}{fg=blue,bg=white}
\setbeamercolor{title in head/foot}{fg=blue,bg=black}
\setbeamercolor{website in footline}{fg=blue,bg=black}
\setbeamercolor{email in footline}{fg=blue,bg=black}

\setbeamercolor*{normal text}{fg=black, bg=white}
\setbeamercolor*{block body}{fg=black,bg=white}
\setbeamercolor*{block title}{fg=black,bg=lightgray}
\setbeamerfont{block title}{size=\large,series=\sc\bf}
\setbeamercolor{upper separation line head}{fg=black}

% \setbeamertemplate{blocks}[rounded][shadow=true]

% \setbeamertemplate{itemize items}[triangle]
\setbeamertemplate{navigation symbols}{}  % no navigation on a poster

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setbeamertemplate{block begin}{
  \vskip.5ex
  \begin{beamercolorbox}[rounded=true,shadow=true,leftskip=1ex,colsep*=.5ex]{block title}%
    \usebeamerfont*{block title}{\Large \insertblocktitle}
  \end{beamercolorbox}%
  {\ifbeamercolorempty[bg]{block body}{}{\nointerlineskip\vskip-0.5pt}}%
  \usebeamerfont{block body}%
  \begin{beamercolorbox}[rounded=true,shadow=false,colsep*=.5ex,sep=.5ex,vmode]{block body}%
    \ifbeamercolorempty[bg]{block body}{\vskip-.25ex}{\vskip-.5ex}\vbox{}%
  }
  \setbeamertemplate{block end}{
  \end{beamercolorbox}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\setbeamertemplate{headline}{
  \leavevmode
  \begin{beamercolorbox}[wd=\paperwidth]{headline}
  \vskip4ex
    \begin{columns}[T]
      \begin{column}{.02\paperwidth}
      \end{column}
      \begin{column}{.12\paperwidth}
        \centering
        \vskip8ex
        \includegraphics[scale=0.85]{LOGO.png}
        \vspace{6pt}
      \end{column}
      \begin{column}{.69\paperwidth}
        \vskip14ex
        \centering
        \usebeamercolor{title in headline}{\color{fg}\textbf{\veryHuge{\inserttitle}}\\[2ex]}
         \vskip2ex
        \usebeamercolor{author in headline}{\color{fg}\Large{\insertauthor}\\[1ex]}
        \usebeamercolor{institute in headline}{\color{fg}\large{\insertinstitute}\\[1ex]}
        \vskip2ex
      \end{column}
      \begin{column}{.3\paperwidth}
        %\raggedleft
        \vskip9ex
        \includegraphics[scale=1.25]{PosterDFTFE/LogoMatrix.png}\\
         \vskip2ex
        % \large{\color{blue}Center for  Predictive}\\
       %      \large{\color{blue}Integrated}\\ 
       %\large{\color{blue}Structural Materials Science}
       %width=0.18\paperwidth
        \vspace{1pt}
      \end{column}
      \begin{column}{.07\paperwidth}
      \end{column}
    \end{columns}
  \end{beamercolorbox}

  \begin{beamercolorbox}[wd=\paperwidth]{lower separation line head}
    \vspace{0.5pt}
    \rule{0pt}{3pt}
  \end{beamercolorbox}
}

